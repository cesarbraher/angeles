# INSTRUCCIÓN: Copiar este archivo como `.env` en el servidor de producción
# (`cp .env.example .env`) y completar las credenciales reales. NUNCA subir `.env` a GitHub.

APP_NAME="ANGELES"
APP_ENV="beta"
APP_DOMAIN="https://cebraher.org/angeles"
APP_AUTHOR="Cesar Augusto Bravo Hernandez"
APP_ROLE="CESAR A. BRAVO - DevRel @Google"
APP_AUTHOR_EMAIL="cesarbraher@gmail.com"
APP_AUTHOR_WEB="https://cebraher.com"

# Conexión MySQL Fase Beta (cebraher.com / cebraher.org)
# Para desarrollo local sin MySQL, cambiar DB_ENGINE="sqlite" o definir DATABASE_URL="sqlite:///./angeles_dev.db"
DB_ENGINE="mysql+pymysql"
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="u529127178_adulam"
DB_USER="u529127178_angeles"
DB_PASSWORD="[CONFIGURAR_EN_SERVIDOR_ENV]"

# Opcional: URL directa (tiene prioridad sobre DB_*; compatible con MySQL o PostgreSQL)
# DATABASE_URL="mysql+pymysql://u529127178_angeles:PASSWORD@localhost:3306/u529127178_adulam?charset=utf8mb4"
# DATABASE_URL="postgresql+psycopg2://user:password@host:5432/angeles"

# Seguridad JWT & Sesiones Clínicas
JWT_SECRET_KEY="[GENERAR_CLAVE_SEGURA_256_BITS]"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="480"
INACTIVITY_TIMEOUT_MINUTES="20"

# Google Gemini AI (Asistente Clínico SOAP — Borrador Editable)
GEMINI_API_KEY="[API_KEY_GOOGLE_GEMINI]"
GEMINI_MODEL="gemini-2.5-flash"

# CORS (orígenes permitidos separados por coma)
CORS_ORIGINS="https://cebraher.org,https://www.cebraher.org,https://braher.org,https://www.braher.org,https://cebraher.com,http://localhost:8000,http://127.0.0.1:8000"
